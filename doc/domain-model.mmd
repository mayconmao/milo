classDiagram
    direction LR

    class Message {
        <<entity · imutável>>
        id
        user_id
        channel: Channel
        external_id
        text
        received_at
    }

    class Interpretation {
        <<registro do LLM>>
        id
        message_id
        intent: Intent
        payload: JSON
        model
        prompt_version
    }

    class Operation {
        <<aggregate root>>
        id
        user_id
        kind: OperationKind
        status: OperationStatus
        source_message_id
        provenance: dict~field, Provenance~
        commit()
        cancel()
        correct(field, value, message_id)
    }

    class Transaction {
        type: TransactionType
        amount: Money
        description
        category_id
        asset_id?
        purpose: Purpose
        tags
        occurred_at
    }

    class PendingClarification {
        <<aggregate root>>
        id
        operation_id
        field
        prompt_message_id
        status: PendingStatus
        asked_at
        reminders_sent
        closed_at?
        close_reason?
        answer(value)
        close_without_answer()
    }

    class OperationEvent {
        <<append-only>>
        id
        operation_id
        kind
        old_value?
        new_value?
        source_message_id?
        source
        created_at
    }

    class Confirmation {
        <<expira em 15 min>>
        id
        action
        target_operation_ids
        prompt_message_id
        status
        expires_at
    }

    class LearnedRule {
        <<criada só com o sim do usuário>>
        id
        user_id
        kind: RuleKind
        pattern
        target
    }

    class Category {
        <<dado no banco>>
        id
        user_id?
        parent_id?
        name
        slug
    }

    class Asset {
        <<dado no banco>>
        id
        user_id
        kind: AssetKind
        name
        is_default
    }

    class Money {
        <<value object>>
        amount: Decimal
        currency = BRL
    }

    Message "1" --> "0..1" Interpretation : interpretada em
    Message "1" --> "0..1" Operation : origina
    Operation "1" *-- "1" Transaction : detalhe
    PendingClarification "0..*" --> "1" Operation : aguarda campo de
    Operation "1" *-- "0..*" OperationEvent : histórico
    Confirmation "0..*" --> "1..*" Operation : confirma ação sobre
    Transaction --> Category
    Transaction --> Asset
    Category --> Category : parent
